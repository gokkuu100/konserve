<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/profileMenuItem"
            style="@style/MenuItemStyle"
            android:text="Profile"
            android:drawableStart="@drawable/baseline_person_24"/>

        <TextView
            android:id="@+id/reportMenuItem"
            style="@style/MenuItemStyle"
            android:text="Report Incident"
            android:drawableStart="@drawable/baseline_report_problem_24"/>

        <TextView
            android:id="@+id/talkMenuItem"
            style="@style/MenuItemStyle"
            android:text="Talk to Us"
            android:drawableStart="@drawable/baseline_bug_report_24"/>

        <TextView
            android:id="@+id/aboutMenuItem"
            style="@style/MenuItemStyle"
            android:text="About"
            android:drawableStart="@drawable/baseline_info_24"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:id="@+id/logoutMenuItem"
            style="@style/MenuItemStyle"
            android:text="Logout"
            android:textColor="#FF0000"
            android:drawableStart="@drawable/baseline_logout_24"/>

    </LinearLayout>

</androidx.cardview.widget.CardView> 